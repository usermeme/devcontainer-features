{
  "name": "devcontainer-features",
  "version": "1.0.0",
  "description": "Dev Container Features by @usermeme",
  "scripts": {
    "test": "export TMPDIR=${TMPDIR:-/tmp} && devcontainer features test --project-folder .",
    "test:worktree": "devcontainer features test --project-folder . --skip-autogenerated -f worktree",
    "test:dotfiles": "devcontainer features test --project-folder . -f dotfiles",
    "test:pnpm": "devcontainer features test --project-folder . -f pnpm",
    "test:yarn": "devcontainer features test --project-folder . --skip-autogenerated -f yarn",
    "test:antigravity": "devcontainer features test --project-folder . -f antigravity",
    "test:opencode": "devcontainer features test --project-folder . -f opencode",
    "test:cline": "devcontainer features test --project-folder . -f cline",
    "test:kilocode": "devcontainer features test --project-folder . -f kilocode",
    "test:neovim": "devcontainer features test --project-folder . --skip-autogenerated -f neovim",
    "test:node-modules-volume": "devcontainer features test --project-folder . -f node-modules-volume",
    "test:github": "devcontainer features test --project-folder . -f github",
    "test:penpot": "devcontainer features test --project-folder . -f penpot",
    "generate-docs": "devcontainer features generate-docs --project-folder src --registry ghcr.io --namespace usermeme/devcontainer-features"
  },
  "keywords": [
    "devcontainer",
    "devcontainer-features",
    "vscode",
    "containers"
  ],
  "author": "usermeme",
  "license": "MIT"
}
