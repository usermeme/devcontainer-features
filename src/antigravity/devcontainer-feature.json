{
  "id": "antigravity",
  "version": "1.0.0",
  "name": "Antigravity CLI & Host Environment",
  "description": "Installs Antigravity CLI and mounts host credentials, skills (~/.agents/skills), and Google Cloud config for seamless pair-programming inside devcontainer.",
  "options": {
    "symlinkSkills": {
      "type": "boolean",
      "default": true,
      "description": "Symlink ~/.agents/skills to ~/.gemini/skills inside the container"
    }
  },
  "containerEnv": {
    "PATH": "/home/node/.local/bin:${PATH}"
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.gemini",
      "target": "/home/node/.gemini",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.agents/skills",
      "target": "/home/node/.agents/skills",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.config/gcloud",
      "target": "/home/node/.config/gcloud",
      "type": "bind"
    }
  ],
  "postCreateCommand": "/usr/local/share/antigravity/setup-antigravity.sh"
}
